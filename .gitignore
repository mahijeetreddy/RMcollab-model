# Dependencies and build output
node_modules/
dist/
build/
*.tsbuildinfo

# Secrets: every .env variant, but keep the documented template.
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Runtime data. storage/ holds users' uploads; models/ holds downloaded weights
# (Real-ESRGAN, Whisper, DeepFilterNet), which are large and fetched on first use.
storage/*
!storage/.gitkeep
models/
*.pth
*.onnx
*.bin

# Test output
test-results/
playwright-report/
coverage/

# Logs and OS noise
*.log
.DS_Store
Thumbs.db
